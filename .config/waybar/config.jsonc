{
  "layer": "top",
  "position": "top",
  "height": 38,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "custom/focus"
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "battery",
    "tray"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": true,
    "all-outputs": false
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 60
  },
  "custom/focus": {
    "exec": "\"$HOME/.local/bin/focus-mode\" --watch",
    "return-type": "json",
    "restart-interval": 5,
    "exec-on-event": false,
    "format": "{}",
    "on-click": "\"$HOME/.local/bin/focus-mode\"",
    "on-click-right": "\"$HOME/.local/bin/focus-mode\" stop",
    "escape": true
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  wired",
    "format-disconnected": "󰤮  offline",
    "tooltip-format": "{ifname}: {ipaddr}"
  },
  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  muted",
    "on-click": "pavucontrol"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "tray": {
    "spacing": 10
  }
}
